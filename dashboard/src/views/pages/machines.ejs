<%- include('../partials/header', { title: 'Machines', path, currentUser }) %>
<div class="row g-4">
  <div class="col-lg-4">
    <div class="card"><div class="card-header">Add Machine</div><div class="card-body">
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <form method="post" action="/machines">
        <input class="form-control mb-2" name="name" placeholder="Display name" required />
        <input class="form-control mb-2" name="host" placeholder="Hostname or IP" required />
        <input class="form-control mb-2" type="number" name="port" value="4100" required />
        <input class="form-control mb-2" name="apiKey" placeholder="Agent API key" required />
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="isActive" checked /> <label class="form-check-label">Active</label></div>
        <button class="btn btn-primary">Add Machine</button>
      </form>
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="card"><div class="card-header">Registered Machines</div><div class="table-responsive"><table class="table table-dark m-0">
      <thead><tr><th>Name</th><th>Host</th><th>Port</th><th>Status</th><th>Created</th><th></th></tr></thead>
      <tbody>
      <% machines.forEach((machine) => { %>
        <tr>
          <td><%= machine.name %></td><td><%= machine.host %></td><td><%= machine.port %></td>
          <td><span class="badge <%= machine.isActive ? 'bg-success' : 'bg-secondary' %>"><%= machine.isActive ? 'Active' : 'Removed' %></span></td>
          <td><%= machine.createdAt.toISOString() %></td>
          <td>
            <% if (machine.isActive) { %>
            <form method="post" action="/machines/<%= machine.id %>/remove" onsubmit="return confirm('Deactivate machine?')">
              <button class="btn btn-sm btn-danger">Remove</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div></div>
  </div>
</div>
<%- include('../partials/footer') %>
