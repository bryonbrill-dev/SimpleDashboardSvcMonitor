<%- include('../partials/header', { title: 'Dashboard', path, currentUser }) %>
<div class="row g-3 mb-4">
  <div class="col-md-2"><div class="kpi-card"><h6>Machines</h6><h3><%= stats.machines %></h3></div></div>
  <div class="col-md-2"><div class="kpi-card"><h6>Services</h6><h3><%= stats.services %></h3></div></div>
  <div class="col-md-2"><div class="kpi-card success"><h6>UP</h6><h3><%= stats.upCount %></h3></div></div>
  <div class="col-md-2"><div class="kpi-card danger"><h6>DOWN</h6><h3><%= stats.downCount %></h3></div></div>
  <div class="col-md-4"><div class="kpi-card"><h6>Last Successful Poll</h6><h6><%= stats.lastPoll ? stats.lastPoll.toISOString() : 'Never' %></h6></div></div>
</div>

<div class="card mb-4">
  <div class="card-header">Timeline Filters</div>
  <div class="card-body">
    <form id="dashboard-filters" class="row g-3 align-items-end" method="get" action="/">
      <div class="col-lg-4">
        <label class="form-label">Service</label>
        <select name="serviceId" class="form-select form-select-sm bg-dark text-light border-secondary">
          <option value="">All services</option>
          <% servicesForFilter.forEach((service) => { %>
            <option value="<%= service.id %>" <%= String(filters.serviceId || '') === String(service.id) ? 'selected' : '' %>><%= service.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-3">
        <label class="form-label">Event Type</label>
        <select name="eventType" class="form-select form-select-sm bg-dark text-light border-secondary">
          <option value="">All events</option>
          <% eventTypeOptions.forEach((eventType) => { %>
            <option value="<%= eventType %>" <%= filters.eventType === eventType ? 'selected' : '' %>><%= eventType %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-3">
        <label class="form-label">Timeline Window</label>
        <select name="windowHours" class="form-select form-select-sm bg-dark text-light border-secondary">
          <% filters.windowOptions.forEach((hours) => { %>
            <option value="<%= hours %>" <%= Number(filters.windowHours) === Number(hours) ? 'selected' : '' %>><%= hours %> hours</option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-2 d-grid gap-2 d-lg-flex justify-content-lg-end">
        <button class="btn btn-sm btn-primary" type="submit">Apply</button>
        <a class="btn btn-sm btn-outline-light" href="/">Reset</a>
      </div>
    </form>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between">
    <span>Service Timeline (<%= filters.windowHours %>h)</span>
    <span class="text-secondary small">Window start: <%= timelineStartIso %></span>
  </div>
  <div class="card-body timeline-wrapper">
    <% if (!timelineRows.length) { %>
      <p class="text-secondary m-0">No timeline points yet for the selected filter.</p>
    <% } %>
    <% timelineRows.forEach((row) => { %>
      <div class="timeline-row mb-3">
        <div class="timeline-label"><strong><%= row.machineName %></strong><br /><span class="text-secondary"><%= row.displayName %></span></div>
        <div class="timeline-track" role="img" aria-label="Timeline for <%= row.displayName %>">
          <% row.points.forEach((point) => { %>
            <span class="timeline-point <%= badgeClass(point.status) %>" style="left: <%= point.left %>%" title="<%= point.checkedAtIso %> - <%= point.status %>"></span>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<div class="card">
  <div class="card-header">Recent Events</div>
  <div class="card-body p-0">
    <table class="table table-dark table-striped m-0">
      <thead><tr><th>Time</th><th>Machine</th><th>Service</th><th>Event</th><th>Message</th></tr></thead>
      <tbody>
        <% events.forEach((event) => { %>
        <tr>
          <td><%= event.createdAt.toISOString() %></td>
          <td><%= event.machine?.name || '-' %></td>
          <td><%= event.monitoredService?.serviceName || '-' %></td>
          <td><span class="badge bg-info"><%= event.eventType %></span></td>
          <td><%= event.message %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
  window.dashboardHeartbeatConfig = {
    path: '/dashboard/heartbeat',
    baselinePollAt: <%- JSON.stringify(stats.lastPoll ? stats.lastPoll.toISOString() : null) %>,
    checkEveryMs: 15000
  };
</script>
<%- include('../partials/footer') %>
