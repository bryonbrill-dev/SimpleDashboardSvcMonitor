<%- include('../partials/header', { title: 'Monitored Services', path, currentUser }) %>
<div class="row g-4">
  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-header">Discover Services</div><div class="card-body">
      <form method="post" action="/services/discover">
        <select class="form-select mb-2" name="machineId" required>
          <% machines.forEach((machine) => { %><option value="<%= machine.id %>"><%= machine.name %></option><% }) %>
        </select>
        <button class="btn btn-outline-info">Load from Agent</button>
      </form>
      <% if (discoveredServices.length) { %>
      <div class="mt-3 small text-muted">Loaded <%= discoveredServices.length %> services. Pick one below.</div>
      <% } %>
    </div></div>
    <div class="card"><div class="card-header">Add Monitored Service</div><div class="card-body">
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <form method="post" action="/services">
        <label class="form-label">Machine</label>
        <select class="form-select mb-2" name="machineId" required>
          <% machines.forEach((machine) => { %><option value="<%= machine.id %>"><%= machine.name %></option><% }) %>
        </select>
        <label class="form-label">Discovered Services</label>
        <select class="form-select mb-2" name="discoveredServiceName">
          <option value="">-- Manual entry below --</option>
          <% discoveredServices.forEach((item) => { %>
            <option value="<%= item.serviceName %>"><%= item.serviceName %> - <%= item.displayName %></option>
          <% }) %>
        </select>
        <input class="form-control mb-2" name="manualServiceName" placeholder="Service Name (manual)" />
        <input class="form-control mb-2" name="displayName" placeholder="Display Name" />
        <button class="btn btn-primary">Add Service</button>
      </form>
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="card"><div class="card-header">Tracked Services</div><div class="table-responsive"><table class="table table-dark m-0">
      <thead><tr><th>Machine</th><th>Service</th><th>Status</th><th>Start</th><th>Last Checked</th><th></th></tr></thead>
      <tbody>
        <% services.forEach((svc) => { %>
        <tr>
          <td><%= svc.machine.name %></td>
          <td><%= svc.serviceName %> <div class="text-muted small"><%= svc.displayName || '' %></div></td>
          <td><span class="badge <%= badgeClass(svc.currentStatus) %>"><%= svc.currentStatus %></span></td>
          <td><%= svc.monitoringStartDate.toISOString() %></td>
          <td><%= svc.lastCheckedAt ? svc.lastCheckedAt.toISOString() : '-' %></td>
          <td>
            <% if (svc.isActive) { %>
            <form method="post" action="/services/<%= svc.id %>/remove" onsubmit="return confirm('Remove monitored service?')"><button class="btn btn-sm btn-danger">Remove</button></form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table></div></div>
  </div>
</div>
<%- include('../partials/footer') %>
